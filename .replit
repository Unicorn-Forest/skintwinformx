modules = ["bash", "nodejs-20"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["glibc"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "SkinTwin Production Server"

[[workflows.workflow]]
name = "SkinTwin Production Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 HOST=0.0.0.0 npx @remix-run/serve build/server/index.js"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3000
externalPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 40043
externalPort = 3003
exposeLocalhost = true

[[ports]]
localPort = 46137
externalPort = 3001
exposeLocalhost = true

[deployment]
deploymentTarget = "vm"
run = ["sh", "-c", "PORT=5000 HOST=0.0.0.0 npx @remix-run/serve build/server/index.js"]
build = ["pnpm", "build"]
