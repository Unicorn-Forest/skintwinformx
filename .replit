modules = ["bash", "nodejs-20"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["glibc"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "SkinTwin Dev Server"

[[workflows.workflow]]
name = "SkinTwin Dev Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 33769
externalPort = 3000
exposeLocalhost = true

[[ports]]
localPort = 35753
externalPort = 3002
exposeLocalhost = true

[[ports]]
localPort = 40043
externalPort = 3003
exposeLocalhost = true

[[ports]]
localPort = 41655
externalPort = 4200

[[ports]]
localPort = 46137
externalPort = 3001
exposeLocalhost = true

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "run"]
build = ["npm", "run", "build"]
